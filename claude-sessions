#!/usr/bin/env python3
"""claude-sessions: save open Claude Code sessions before a reboot, restore them after.

  claude-sessions save                      snapshot every running interactive session
  claude-sessions restore                   reopen each one in a new tab/window: claude --resume <id>
  claude-sessions restore --dry-run         print the commands, open nothing
  claude-sessions restore --terminal NAME   force a launcher (see TERMINALS below)
  claude-sessions list                      show running vs saved
  claude-sessions --version

Works on macOS, Linux (incl. WSL) and Windows; needs only Python 3.7+.
Source:   <claude config dir>/sessions/<pid>.json (Claude Code writes one per live session)
Snapshot: <claude config dir>/saved-sessions.tsv  (pid, sessionId, cwd, name)
The config dir is $CLAUDE_CONFIG_DIR if set, else ~/.claude.
"""
import glob
import json
import os
import shlex
import shutil
import subprocess
import sys

__version__ = "0.1.0"

IS_WIN = os.name == "nt"
IS_MAC = sys.platform == "darwin"
CLAUDE_DIR = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
SESS_DIR = os.path.join(CLAUDE_DIR, "sessions")
SAVE_FILE = os.environ.get("CLAUDE_SESSIONS_FILE") or os.path.join(CLAUDE_DIR, "saved-sessions.tsv")


# ---------------------------------------------------------------- discovery

def process_name(pid):
    """Image name of a live pid, or None if the pid isn't running."""
    try:
        if IS_WIN:
            # Never use os.kill(pid, 0) on Windows: it calls TerminateProcess.
            out = subprocess.run(["tasklist", "/FI", "PID eq %d" % pid, "/FO", "CSV", "/NH"],
                                 capture_output=True, text=True).stdout.strip()
            return out.split('","')[0].strip('"') if out.startswith('"') else None
        out = subprocess.run(["ps", "-p", str(pid), "-o", "comm="],
                             capture_output=True, text=True).stdout.strip()
        return out or None
    except OSError:
        return None


def live_sessions():
    rows = []
    for f in sorted(glob.glob(os.path.join(SESS_DIR, "*.json"))):
        try:
            with open(f, encoding="utf-8") as fh:
                d = json.load(fh)
        except (OSError, ValueError):
            continue
        if d.get("kind", "interactive") != "interactive" or not d.get("sessionId"):
            continue
        name = process_name(int(d.get("pid") or 0))
        if not name or "claude" not in name.lower():   # gone, or pid reused by another program
            continue
        rows.append({"pid": str(d["pid"]), "sid": d["sessionId"], "cwd": d.get("cwd") or os.path.expanduser("~"),
                     "name": " ".join(str(d.get("name") or "").split()), "status": d.get("status", ""),
                     "updated": d.get("updatedAt") or 0})
    return rows


def unique_sessions(rows):
    """Same session open in two processes: keep the most recently active one."""
    best = {}
    for r in rows:
        if r["sid"] not in best or r["updated"] > best[r["sid"]]["updated"]:
            best[r["sid"]] = r
    dupes = len(rows) - len(best)
    if dupes:
        print("note: %d session(s) are open in more than one process; saving each once." % dupes)
    return [r for r in rows if best[r["sid"]] is r]


def read_saved():
    rows = []
    try:
        with open(SAVE_FILE, encoding="utf-8") as fh:
            for line in fh:
                parts = line.rstrip("\n").split("\t")
                if len(parts) >= 3 and parts[1]:
                    rows.append({"pid": parts[0], "sid": parts[1], "cwd": parts[2],
                                 "name": parts[3] if len(parts) > 3 else ""})
    except FileNotFoundError:
        pass
    return rows


def has_transcript(sid):
    return bool(glob.glob(os.path.join(CLAUDE_DIR, "projects", "*", sid + ".jsonl")))


# ---------------------------------------------------------------- launchers
# Each takes a list of jobs {cwd, sid, name} and opens one tab/window per job.

def claude_argv(sid):
    return ["claude", "--resume", sid]


def shell_line(job):
    if IS_WIN:
        return 'cd /d "%s" && claude --resume %s' % (job["cwd"], job["sid"])
    return "cd %s && claude --resume %s" % (shlex.quote(job["cwd"]), job["sid"])


def osa(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def spawn(argv, cwd=None):
    subprocess.Popen(argv, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=not IS_WIN)


def run_iterm(jobs):
    lines = ['tell application "iTerm"', "activate", "set w to (create window with default profile)"]
    for i, j in enumerate(jobs):
        if i:
            lines.append("tell w to create tab with default profile")
        lines += ["tell current session of current tab of w",
                  "write text " + osa(shell_line(j)), "set name to " + osa(j["name"] or j["sid"]), "end tell"]
    lines.append("end tell")
    subprocess.run(["osascript", "-e", "\n".join(lines)], check=True, stdout=subprocess.DEVNULL)


def run_apple_terminal(jobs):
    for j in jobs:
        subprocess.run(["osascript", "-e", 'tell application "Terminal" to do script ' + osa(shell_line(j))],
                       check=True, stdout=subprocess.DEVNULL)
    subprocess.run(["osascript", "-e", 'tell application "Terminal" to activate'], stdout=subprocess.DEVNULL)


def run_tmux(jobs):
    inside = bool(os.environ.get("TMUX"))
    target = None
    for j in jobs:
        title = (j["name"] or j["sid"])[:40]
        if inside or target:
            subprocess.run(["tmux", "new-window", "-c", j["cwd"], "-n", title] +
                           (["-t", target] if target else []) + claude_argv(j["sid"]), check=True)
        else:   # not in tmux: build a detached session the user attaches to
            target = "claude-restore"
            subprocess.run(["tmux", "new-session", "-d", "-s", target, "-c", j["cwd"], "-n", title] +
                           claude_argv(j["sid"]), check=True)
    if target:
        print("Created tmux session '%s'. Attach with:  tmux attach -t %s" % (target, target))


def run_wezterm(jobs):
    inside = bool(os.environ.get("WEZTERM_PANE"))
    for j in jobs:
        if inside:
            subprocess.run(["wezterm", "cli", "spawn", "--cwd", j["cwd"], "--"] + claude_argv(j["sid"]), check=True,
                           stdout=subprocess.DEVNULL)
        else:
            spawn(["wezterm", "start", "--cwd", j["cwd"], "--"] + claude_argv(j["sid"]))


def run_kitty(jobs):
    remote = bool(os.environ.get("KITTY_LISTEN_ON") or os.environ.get("KITTY_WINDOW_ID"))
    for j in jobs:
        title = j["name"] or j["sid"]
        if remote and subprocess.run(["kitty", "@", "launch", "--type=tab", "--cwd", j["cwd"], "--tab-title", title]
                                     + claude_argv(j["sid"]), stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL).returncode == 0:
            continue   # kitty @ needs allow_remote_control; fall back to new windows if it's off
        spawn(["kitty", "--directory", j["cwd"], "--title", title] + claude_argv(j["sid"]))


def run_ghostty(jobs):
    for j in jobs:
        args = ["--working-directory=" + j["cwd"], "-e"] + claude_argv(j["sid"])
        spawn(["open", "-na", "Ghostty", "--args"] + args if IS_MAC else ["ghostty"] + args)


def run_alacritty(jobs):
    for j in jobs:
        spawn(["alacritty", "--working-directory", j["cwd"], "-T", j["name"] or j["sid"], "-e"] + claude_argv(j["sid"]))


def run_gnome(jobs):
    for j in jobs:   # gnome-terminal is client/server: --tab lands in the most recent window
        subprocess.run(["gnome-terminal", "--tab", "--working-directory=" + j["cwd"],
                        "--title=" + (j["name"] or j["sid"]), "--"] + claude_argv(j["sid"]), check=True)


def run_konsole(jobs):
    for j in jobs:
        spawn(["konsole", "--new-tab", "--workdir", j["cwd"], "-e"] + claude_argv(j["sid"]))


def run_xfce(jobs):
    for j in jobs:
        spawn(["xfce4-terminal", "--tab", "--working-directory", j["cwd"], "-T", j["name"] or j["sid"],
               "-x"] + claude_argv(j["sid"]))


def run_xterm(jobs):
    for j in jobs:
        spawn(["xterm", "-T", j["name"] or j["sid"], "-e"] + claude_argv(j["sid"]), cwd=j["cwd"])


def run_windows_terminal(jobs):
    for j in jobs:   # -w 0 = current window, nt = new tab
        subprocess.run(["wt", "-w", "0", "nt", "-d", j["cwd"], "--title", j["name"] or j["sid"],
                        "powershell", "-NoExit", "-Command", "claude --resume " + j["sid"]], check=True)


def run_windows_console(jobs):
    for j in jobs:
        subprocess.Popen(["powershell", "-NoExit", "-Command", "claude --resume " + j["sid"]], cwd=j["cwd"],
                         creationflags=getattr(subprocess, "CREATE_NEW_CONSOLE", 0))


TERMINALS = {
    "iterm": run_iterm, "terminal": run_apple_terminal, "tmux": run_tmux, "wezterm": run_wezterm,
    "kitty": run_kitty, "ghostty": run_ghostty, "alacritty": run_alacritty, "gnome-terminal": run_gnome,
    "konsole": run_konsole, "xfce4-terminal": run_xfce, "xterm": run_xterm, "wt": run_windows_terminal,
    "windows-console": run_windows_console, "print": None,
}


def detect_terminal():
    """Prefer the terminal this command is running in; else any installed one; else print."""
    e = os.environ.get
    tp = (e("TERM_PROGRAM") or "").lower()
    if e("TMUX"):
        return "tmux"
    if tp == "iterm.app":
        return "iterm"
    if tp == "apple_terminal":
        return "terminal"
    if tp == "wezterm" or e("WEZTERM_PANE"):
        return "wezterm"
    if tp == "ghostty" or e("GHOSTTY_RESOURCES_DIR"):
        return "ghostty"
    if e("KITTY_WINDOW_ID"):
        return "kitty"
    if e("ALACRITTY_WINDOW_ID") or e("ALACRITTY_SOCKET"):
        return "alacritty"
    if e("WT_SESSION") and IS_WIN:
        return "wt"
    if e("KONSOLE_VERSION"):
        return "konsole"
    if e("GNOME_TERMINAL_SCREEN") or e("VTE_VERSION"):
        return "gnome-terminal"
    # Not inside a recognisable terminal (VS Code, ssh, cron, after login...): pick something installed.
    if IS_MAC:
        return "iterm" if os.path.isdir("/Applications/iTerm.app") else "terminal"
    if IS_WIN:
        return "wt" if shutil.which("wt") else "windows-console"
    for t in ("gnome-terminal", "konsole", "xfce4-terminal", "kitty", "wezterm", "alacritty", "xterm", "tmux"):
        if shutil.which(t) and (t == "tmux" or e("DISPLAY") or e("WAYLAND_DISPLAY")):
            return t
    return "print"


# ---------------------------------------------------------------- commands

def cmd_save():
    rows = unique_sessions(live_sessions())
    if not rows:
        print("No running Claude sessions found in " + SESS_DIR)
        return 1
    if os.path.exists(SAVE_FILE):
        shutil.copyfile(SAVE_FILE, SAVE_FILE + ".bak")
    with open(SAVE_FILE, "w", encoding="utf-8") as fh:
        for r in rows:
            fh.write("\t".join([r["pid"], r["sid"], r["cwd"], r["name"]]) + "\n")
    print("Saved %d session(s) to %s:" % (len(rows), SAVE_FILE))
    for r in rows:
        print("  %-36s  %-5s  %s  (%s)" % (r["sid"], r["status"], r["cwd"], r["name"]))
        if r["status"] == "busy":
            print("      ^ still busy: let it finish, or it resumes mid-turn")
    return 0


def cmd_list():
    print("== Running now ==")
    for r in live_sessions():
        print("  %-7s %-36s %-5s %s  (%s)" % (r["pid"], r["sid"], r["status"], r["cwd"], r["name"]))
    print("== Saved (%s) ==" % SAVE_FILE)
    saved = read_saved()
    for r in saved:
        print("  %-36s %s  (%s)" % (r["sid"], r["cwd"], r["name"]))
    if not saved:
        print("  (none)")
    print("Restore would use terminal: " + detect_terminal())
    return 0


def cmd_restore(args):
    dry = "--dry-run" in args
    i = args.index("--terminal") if "--terminal" in args else -1
    term = args[i + 1] if 0 <= i < len(args) - 1 else detect_terminal()
    if term not in TERMINALS:
        print("Unknown terminal '%s'. Choose from: %s" % (term, ", ".join(TERMINALS)))
        return 2
    saved = read_saved()
    if not saved:
        print("Nothing saved at %s. Run 'claude-sessions save' first." % SAVE_FILE)
        return 1
    running = {r["sid"] for r in live_sessions()}
    jobs = []
    for r in saved:
        if r["sid"] in running:
            print("skip (already running): %s %s" % (r["sid"], r["name"]))
        elif not has_transcript(r["sid"]):
            print("skip (no transcript):   %s %s" % (r["sid"], r["name"]))
        elif not os.path.isdir(r["cwd"]):
            print("skip (folder missing):  %s %s" % (r["sid"], r["cwd"]))
        else:
            jobs.append(r)
    if not jobs:
        print("Nothing to restore.")
        return 0
    if dry or term == "print":
        if term == "print":
            print("No supported terminal detected; run each of these in its own tab:")
        for j in jobs:
            print(shell_line(j))
        return 0
    if term not in ("iterm", "terminal") and not shutil.which({"windows-console": "powershell"}.get(term, term)):
        print("'%s' is not on PATH. Use --terminal to pick another, or --dry-run to print the commands." % term)
        return 1
    TERMINALS[term](jobs)
    print("Restored %d session(s) via %s." % (len(jobs), term))
    return 0


def main(argv):
    cmd = argv[0] if argv else "list"
    if cmd == "save":
        return cmd_save()
    if cmd == "restore":
        return cmd_restore(argv[1:])
    if cmd == "list":
        return cmd_list()
    if cmd in ("-V", "--version", "version"):
        print("claude-sessions " + __version__)
        return 0
    print(__doc__)
    return 0 if cmd in ("-h", "--help", "help") else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
